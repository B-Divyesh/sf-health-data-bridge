{
  "name": "health-data-bridge",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "cap:sync": "npm run build && cap sync android && node scripts/exclude-android-download.mjs",
    "android:build": "npm run cap:sync && cd android && ./gradlew :app:clean :app:assembleDebug test assembleDebugAndroidTest"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
